default_column1_background=6  # black
default_column1_font_color=3  # green
default_column2_background=4  # blue
default_column2_font_color=2  # red

config_file="colors.conf"

if [[ -f "$config_file" ]]; then
    source "$config_file"
fi

column1_background_final=${column1_background:-$default_column1_background}
column1_font_color_final=${column1_font_color:-$default_column1_font_color}
column2_background_final=${column2_background:-$default_column2_background}
column2_font_color_final=${column2_font_color:-$default_column2_font_color}

validate_color() {
    local color=$1
    if [[ "$color" -lt 1 || "$color" -gt 6 ]]; then
        echo "Incorrect input: parameters must be digits from 1 to 6"
        exit 1
    fi
}

validate_color "$column1_background_final"
validate_color "$column1_font_color_final"
validate_color "$column2_background_final"
validate_color "$column2_font_color_final"

if [ "$column1_background_final" -eq "$column1_font_color_final" ] || [ "$column2_background_final" -eq "$column2_font_color_final" ]; then
    echo "Incorrect input: background color and font color for the same column cannot match"
    echo "Please restart script with correct parameters"
    exit 0
fi
